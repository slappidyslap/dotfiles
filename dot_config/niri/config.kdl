// Default niri config: https://github.com/niri-wm/niri/blob/main/resources/default-config.kdl
// spawn-sh-at-startup "swaybg -i ~/Pictures/wallhaven-pomle9.jpg"
environment {
  XDG_CURRENT_DESKTOP "niri"
  QT_QPA_PLATFORMTHEME "xdgdesktopportal"
  TERMINAL "kitty -1"
  ALT_TERMINAL "alacritty"
  FILE_MANAGER "kitty -1 -e yazi"
  ALT_FILE_MANAGER "nautilus"
  BROWSER "zen-browser"
}


include "noctalia.kdl"

include "input.kdl"
include "layout.kdl"
include "colors.kdl"
include "binds.kdl"
include "workspaces.kdl"
include "window-rules.kdl"
include "animations/glide.kdl"
include "misc.kdl"
