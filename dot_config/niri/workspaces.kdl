workspace "music"
workspace "message"
workspace "dev"
workspace "browser"
workspace "misc"
workspace "games"

window-rule {
    exclude app-id="kitty"
    // exclude app-id="imv"
    exclude app-id="mpv"
    exclude app-id=r#"Nautilus$"#
    exclude app-id=r#"Loupe$"#
    exclude app-id="zathura"
    open-on-workspace "misc"
}

window-rule {
    match app-id="Spotify"
    match app-id="ncspot"
    open-on-workspace "music"
}

window-rule {
    match app-id="telegram"
    match app-id="vesktop"
    match app-id="serein" // не фокусится todo
    open-on-workspace "message"
}

window-rule {
    match app-id="idea"
    match app-id="zed"
    match app-id="codium"
    match app-id="^jetbrains-toolbox$" // it automatically opens IntelliJ IDEA in the same workspace
    // match app-id="jetbrains-idea"
    open-on-workspace "dev"
}

window-rule {
    // match app-id="firefox"
    // match app-id="librewolf"
    match app-id="zen"
    // match app-id="helium"
    match app-id=r#"Thunderbird"#
    match app-id="Obsidian"
    open-on-workspace "browser"
}

window-rule {
    match app-id="duckstation"
    // match app-id="pcsx2"
    match app-id="steam" // не фокусится todo
    open-on-workspace "games"
}
