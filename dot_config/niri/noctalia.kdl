spawn-at-startup "noctalia"

binds {
    // Mod+Shift+S { spawn-sh "/home/eld/Extras/noctalia/build-release/noctalia msg screenshot-window"; }
    Mod+Space { spawn-sh "noctalia msg panel-toggle launcher"; }
    Mod+S { spawn-sh "noctalia msg panel-toggle control-center"; }
    Mod+V { spawn-sh "noctalia msg panel-toggle clipboard"; }

    XF86AudioRaiseVolume { spawn-sh "noctalia msg volume-up"; }
    XF86AudioLowerVolume { spawn-sh "noctalia msg volume-down"; }
    Shift+XF86AudioRaiseVolume { spawn-sh "noctalia msg volume-up 1"; }
    Shift+XF86AudioLowerVolume { spawn-sh "noctalia msg volume-down 1"; }
    XF86AudioMute { spawn-sh "noctalia msg volume-mute"; }

    XF86MonBrightnessUp { spawn-sh "noctalia msg brightness-up"; }
    XF86MonBrightnessDown { spawn-sh "noctalia msg brightness-down"; }
    Shift+XF86MonBrightnessUp { spawn-sh "noctalia msg brightness-up 1"; }
    Shift+XF86MonBrightnessDown { spawn-sh "noctalia msg brightness-down 1"; }
}


// Place the regular wallpaper on the backdrop.
layer-rule {
  match namespace="^noctalia-wallpaper"
  place-within-backdrop true
}

// Optionally, disable workspace shadows in the overview.
overview {
  workspace-shadow {
    off
  }
}

output "eDP-1" {
    mode "2256x1504@59.999"
    scale 1.6
    position x=0 y=0
}

