{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "small",
        "padding": {
          "right": 1
        } 
    },
    "display": {
        "separator": "  "
    },
    "modules": [
        "title",
        {
            "type": "host",
            "key": "host  ",
            "format": "{name}",
            "keyColor": "red"
        },
        {
            "type": "kernel",
            "key": "kernel",
            "keyColor": "green"
        },
        {
            "type": "cpu",
            "key": "cpu   ",
            "format": "{name}",
            "keyColor": "yellow"
        },
        {
            "type": "gpu",
            "key": "gpu   ",
            "format": "{vendor} {name}",
            "keyColor": "blue"
        },
        {
            "type": "memory",
            "key": "memory",
            "keyColor": "magenta"
        },
        {
            "type": "wm",
            "key": "wm    ",
            "format": "{pretty-name} {version}",
            "keyColor": "cyan"
        },
        "break"
    ]
}
